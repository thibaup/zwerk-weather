<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:description="@string/combined_forecast_widget_description"
    android:configure="com.zwerk.weather.WidgetConfigurationActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_forecast"
    android:minWidth="280dp"
    android:minHeight="144dp"
    android:minResizeWidth="240dp"
    android:minResizeHeight="118dp"
    android:previewLayout="@layout/widget_forecast_picker_preview"
    android:previewImage="@drawable/widget_forecast_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
